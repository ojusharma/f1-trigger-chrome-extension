{
  "manifest_version": 3,
  "name": "F1 Word Racer (dev)",
  "version": "0.1.0",
  "description": "When certain words are typed, F1 cars race across the screen!",
  "icons": {
    "16": "icons/a-16.png",
    "48": "icons/a-48.png",
    "128": "icons/a-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "F1 Word Racer"
  },
  "permissions": [
    "storage",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content_script.js"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["images/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "options_page": "options.html"
}
