{
  "manifest_version": 3,
  "name": "F1 Word Racer",
  "version": "1.0.0",
  "description": "Watch F1 cars race across your screen when you type trigger words. Always expect the unexpected in F1.",
  "author": "Ojus Sharma",
  "icons": {
    "16": "icons/a-16.png",
    "48": "icons/a-48.png",
    "128": "icons/a-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "F1 Word Racer"
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content_script.js"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["images/*", "styles/*", "sounds/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  }
}
